./configure && make && make install
## for ffmpeg
wget https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz
tar -xf ffmpeg-release-amd64-static.tar.xz
cd ffmpeg-*-amd64-static
cp ffmpeg ffprobe /usr/local/bin/
## gdal 
dnf groupinstall -y "Development Tools"
dnf install -y cmake gcc-c++ sqlite-devel libcurl-devel \
                    libtiff-devel libpng-devel libjpeg-turbo-devel \
                    libxml2-devel zlib-devel python3-devel
wget https://download.osgeo.org/proj/proj-9.3.1.tar.gz
tar -xzf proj-9.3.1.tar.gz
cd proj-9.3.1
mkdir build && cd build
cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local
make -j$(nproc)
make install
wget https://github.com/OSGeo/gdal/releases/download/v3.8.5/gdal-3.8.5.tar.gz
tar -xzf gdal-3.8.5.tar.gz
cd gdal-3.8.5
mkdir build && cd build
cmake .. -DGDAL_USE_EXTERNAL_LIBS=OFF -DGDAL_BUILD_OPTIONAL_DRIVERS=OFF -DOGR_BUILD_OPTIONAL_DRIVERS=OF
cmake --build . -j$(nproc)
echo "/usr/local/lib" | tee /etc/ld.so.conf.d/gdal.conf
echo "/usr/local/lib64" | tee -a /etc/ld.so.conf.d/gdal.conf
ldconfig
gdalinfo --version

